SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=
SNOWFLAKE_S3_BUCKET=snowflake-kalshi-project
SNOWFLAKE_S3_PREFIX=raw

KALSHI_API_KEY_ID=
KALSHI_API_KEY=
# Optional AWS Secrets Manager credential source for deployed ingestion.
# When either is set, it takes precedence over KALSHI_API_KEY_ID/KALSHI_API_KEY.
KALSHI_SECRET_ARN=
KALSHI_SECRET_NAME=
KALSHI_EVENTS_STATUS=all
KALSHI_EVENTS_EVENT_TICKER=
KALSHI_EVENTS_SERIES_TICKER=KXMASTERS
# Path to a SQL file (absolute, or relative to the repo root) whose result set returns
# a `ticker` column. Example:
# src/market_data_platform/queries/kalshi/events_mlb_series.sql
# Mutually exclusive with KALSHI_EVENTS_EVENT_TICKER and KALSHI_EVENTS_SERIES_TICKER.
KALSHI_EVENTS_SERIES_QUERY_FILE=
KALSHI_EVENT_TICKER=KXMASTERS-25
KALSHI_MARKET_TICKER=
# Path to a SQL file (absolute, or relative to the repo root) whose result set returns
# an `event_ticker` column. Example:
# src/market_data_platform/queries/kalshi/markets_mlb_events.sql
# Mutually exclusive with KALSHI_MARKET_TICKER and KALSHI_EVENT_TICKER. Markets
# scraping is expensive (per-market detail calls), so keep the query narrow.
KALSHI_MARKETS_EVENT_QUERY_FILE=

MLB_TEAMS_S3_BUCKET=snowflake-kalshi-project
MLB_TEAMS_S3_PREFIX=raw/mlb/teams
MLB_TEAMS_SPORT_ID=1

DBT_DATABASE=PROD
DBT_SCHEMA=STAGE
DBT_SOURCE_DATABASE=PROD
DBT_SOURCE_SCHEMA=RAW
