aws_region = "us-east-2"

project_name = "snowflake-kalshi"
environment  = "dev"

s3_bucket_name = "snowflake-kalshi-project"
s3_prefix      = "raw/mlb/teams"
kalshi_events_s3_prefix = "raw/kalshi/events"
kalshi_series_s3_prefix = "raw/kalshi/series"
kalshi_markets_s3_prefix          = "raw/kalshi/markets"
kalshi_market_orderbooks_s3_prefix = "raw/kalshi/market_orderbooks"
kalshi_market_trades_s3_prefix     = "raw/kalshi/market_trades"
kalshi_market_trades_state_prefix  = "state/kalshi/market_trades"

# Snowflake pipe notification_channel SQS ARNs from SHOW PIPES.
# Set all three together before applying aws_s3_bucket_notification because
# Terraform owns the bucket's full notification configuration.
mlb_teams_pipe_notification_channel     = null
kalshi_events_pipe_notification_channel = null
kalshi_series_pipe_notification_channel = null

lambda_image_tag               = "latest"
mlb_teams_sport_id             = "1"
mlb_teams_schedule_expression = "cron(0 6 * * ? *)"
mlb_teams_schedule_timezone   = "America/Chicago"
# Intentionally disabled: MLB teams is low-change reference data. Run the
# Lambda manually when this dimension needs a refresh.
mlb_teams_schedule_state      = "DISABLED"
kalshi_events_schedule_expression = "cron(0 * * * ? *)"
kalshi_events_schedule_timezone   = "America/Chicago"
kalshi_events_schedule_state      = "ENABLED"
kalshi_series_schedule_expression = "cron(0 * * * ? *)"
kalshi_series_schedule_timezone   = "America/Chicago"
kalshi_series_schedule_state      = "ENABLED"
kalshi_markets_schedule_expression = "cron(15,45 * * * ? *)"
kalshi_markets_schedule_timezone   = "America/Chicago"
# Runs the SQL-driven Markets scope when no exact market or event binding is set.
kalshi_markets_schedule_state      = "ENABLED"
lambda_timeout_seconds = 60
lambda_memory_mb       = 512
log_retention_days     = 14

# Fill these after running DESC INTEGRATION in Snowflake, then re-apply
# Terraform to replace the initial placeholder trust relationship.
snowflake_storage_aws_iam_user_arn = null
snowflake_storage_aws_external_id  = null

# Optional: ARN for the AWS Secrets Manager secret that stores Kalshi API
# credentials. Use either ARN or name. Do not put secret values in Terraform.
kalshi_api_secret_arn = null
kalshi_api_secret_name = null

# Optional conservative invocation scopes for the Kalshi Lambdas. These can also
# be supplied in the manual invocation payload. For the Markets schedule, leaving
# all three Markets scope values null uses the packaged MLB event-query SQL file;
# fill the Snowflake values below for that SQL-driven scope.
kalshi_events_status        = "open"
kalshi_events_event_ticker  = null
kalshi_events_series_tickers = [
  "KXMLBSPREAD",
  "KXMLBTOTAL",
  "KXMLBGAME",
]
kalshi_series_ticker        = null
kalshi_series_tags          = ["BaseBall"]
kalshi_markets_market_ticker      = null
kalshi_markets_event_ticker       = null
# Optional override for the scheduled SQL scope. Null uses the packaged query:
# src/market_data_platform/queries/kalshi/markets_mlb_events.sql
kalshi_markets_event_query_file   = null
kalshi_markets_paginate_trades    = false
kalshi_market_trades_fetch_mode    = "incremental"
kalshi_market_trades_first_run_lookback_hours = 24
kalshi_market_trades_watermark_overlap_seconds = 60
kalshi_markets_reserved_concurrency = null
kalshi_markets_snowflake_account  = null
kalshi_markets_snowflake_user     = null
kalshi_markets_snowflake_warehouse = null
kalshi_markets_snowflake_role      = null
kalshi_markets_snowflake_private_key_secret_arn = null
kalshi_markets_snowflake_private_key_secret_name = null
